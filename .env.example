# 猫谱科技询价邮箱（163 邮箱）
INQUIRY_SMTP_HOST=smtp.163.com
INQUIRY_SMTP_PORT=465
INQUIRY_SMTP_SECURE=true
INQUIRY_SMTP_USER=morepuretech@163.com
INQUIRY_SMTP_PASS=请填写163邮箱的SMTP客户端授权码
INQUIRY_NOTIFY_TO=morepuretech@163.com

# 可选：正式部署时把询价和附件保存到持久化磁盘
# INQUIRY_DATA_PATH=D:\morepure-data\inquiries.json
# INQUIRY_ATTACHMENT_DIR=D:\morepure-data\attachments

# Administrator access; generate a unique password of at least 16 characters.
# Production MUST use HTTPS. Do not commit actual credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Public HTTPS origin, e.g. https://www.example.com (no trailing slash)
ADMIN_ORIGIN=
